{
  "manifest_version": 3,
  "name": "Kord",
  "version": "1.0",
  "description": "Permet d'enregistrer des URLs vers différents salons Discord.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}